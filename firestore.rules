rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['rebekahzadokmugisha@gmail.com', 'zadokitefamily@gmail.com']; }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('revoked', false) != true;
    }
    match /applications/{email} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.email == email
        && request.resource.data.keys().hasOnly(['name','email','phone','status','createdAt']);
      allow read, update, delete: if isAdmin();
    }
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange']));
      allow create, delete: if isAdmin();
    }
    match /activity/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin() || (signedIn() && request.auth.uid == uid && isMember());
    }
    match /content/{id} { allow read: if isMember() || isAdmin(); allow write: if isAdmin(); }
    match /quizzes/{id} { allow read: if isMember() || isAdmin(); allow write: if isAdmin(); }
    match /givings/{id} {
      allow create: if isMember() && request.resource.data.uid == request.auth.uid && request.resource.data.confirmed == false;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /feedback/{id} { allow read, write: if isAdmin(); }
    match /texts/{id} { allow read: if isMember() || isAdmin(); allow write: if isAdmin(); }
      // Zadokite Study (family study app at /zadokite-study/)
    function isFamily() { return signedIn() && (request.auth.token.email == 'family@zadokite.study' || isAdmin()); }
    match /zadokite_attempts/{id} { allow read, create: if isFamily(); allow update, delete: if isAdmin(); }
    match /zadokite/{doc} { allow read, write: if isFamily(); }
  }
}
