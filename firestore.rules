rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['rebekahzadokmugisha@gmail.com']; }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('revoked', false) != true;
    }
    match /applications/{email} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.email == email
        && request.resource.data.keys().hasOnly(['name','email','phone','status','createdAt']);
      allow read, update, delete: if isAdmin();
    }
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange']));
      allow create, delete: if isAdmin();
    }
    match /activity/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin() || (signedIn() && request.auth.uid == uid && isMember());
    }
    match /content/{id} { allow read: if isMember() || isAdmin(); allow write: if isAdmin(); }
    match /quizzes/{id} { allow read: if isMember() || isAdmin(); allow write: if isAdmin(); }
    match /texts/{id} { allow read: if isMember() || isAdmin(); allow write: if isAdmin(); }
  }
}
